# Postgres connection string (Vercel Postgres / Neon / Supabase all work)
DATABASE_URL="postgresql://user:password@host:5432/fenderbcs?sslmode=require"

# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# Optional: password given to every seeded account on first setup
SEED_PASSWORD="ChangeMe123!"

# Optional — powers "Report a bug". Without it, reports still save to the
# database (Set Up -> Bug reports) but no email goes out.
# Sign up free at https://resend.com, verify a sending domain (or use their
# no-setup test address onboarding@resend.dev while trying this out).
RESEND_API_KEY=""
BUG_REPORT_TO_EMAIL="tyler@fendersteel.co.uk"
BUG_REPORT_FROM_EMAIL="Fender BCS <onboarding@resend.dev>"

# Optional — posts the same "needs attention" alerts (a flagged issue, a
# holiday request) into a Telegram group, alongside the email. Without
# these two, that half of it quietly no-ops.
# 1. In Telegram, message @BotFather, send /newbot, follow the prompts —
#    it gives you a token straight away. That's TELEGRAM_BOT_TOKEN.
# 2. Add that bot to the group you want alerts posted into, same as adding
#    a person.
# 3. Send any message in that group, then visit (in a browser, signed in
#    doesn't matter):
#      https://api.telegram.org/bot<your-token>/getUpdates
#    Find "chat":{"id": ...} in the JSON — that number (it'll be negative
#    for a group) is TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Optional — powers the Google Drive backup on Set Up -> Backups, which
# copies every certificate, compliance/H&S document and photo out to a
# Drive folder once a night. Without these two, that section just shows a
# "Connect Google Drive" button that errors until they're set.
# 1. In https://console.cloud.google.com, create a project (or use an
#    existing one) and enable the "Google Drive API" under APIs & Services.
# 2. Under APIs & Services -> OAuth consent screen: choose External, fill
#    in the required fields, and once it's created, publish it to
#    Production (not Testing) — otherwise Google expires the sign-in after
#    a week and someone has to reconnect it by hand. You'll see an
#    "unverified app" warning when you actually sign in later; that's
#    expected for a small in-house tool like this one — click through it.
# 3. Under APIs & Services -> Credentials, create an OAuth client ID of
#    type "Web application". Add this as an authorised redirect URI
#    (swap in your real domain, or http://localhost:3000 while testing
#    locally):
#      https://fenderbcs.com/api/setup/backups/drive/callback
# 4. Copy the Client ID and Client secret it gives you.
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""

# Once those two are set, sign in from Set Up -> Backups -> Connect Google
# Drive — that one-time sign-in is what actually grants access; there's
# nothing further to configure.

# Optional — required for the nightly backup to actually run on a schedule
# (Set Up -> Backups still has a manual "Sync now" button without it).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Vercel sends this back as a bearer token automatically for anything in
# vercel.json's "crons" list, once it's set as an env var — nothing else to
# configure.
CRON_SECRET=""

# --------------------------------------------------------- sales outreach
# Cold-outreach agent for BCS Products. Sends from its own Microsoft 365
# mailbox on a separate domain — see docs/OUTREACH_SETUP.md for the full
# walkthrough (mailbox, DNS, app registration, and where each value comes from).

# Free API key from https://developer.company-information.service.gov.uk
COMPANIES_HOUSE_API_KEY=""

# Microsoft Entra app registration for the outreach mailbox (setup doc, step 4).
OUTREACH_M365_TENANT_ID=""
OUTREACH_M365_CLIENT_ID=""
OUTREACH_M365_CLIENT_SECRET=""

# The dedicated mailbox emails are sent from and replies arrive in, e.g.
# sales@your-separate-domain.co.uk. Keep it off fendersteel.co.uk and
# bcsproducts.co.uk so cold-email reputation can never touch real mail.
OUTREACH_MAILBOX=""
# Every reply also triggers a heads-up email to this address.
OUTREACH_FORWARD_TO_EMAIL="tyler@fendersteel.co.uk"

# Required on every commercial email under UK PECR/GDPR — nothing is sent
# until both are filled in.
OUTREACH_REGISTERED_ADDRESS=""
OUTREACH_COMPANY_NUMBER=""

# The live site's URL — used to build the unsubscribe link in emails.
OUTREACH_APP_URL="https://fenderbcs.com"

# How many new emails go out per day. Start low (the default is 10) and
# raise it once the copy and the sending domain both have a track record.
OUTREACH_DAILY_SEND_CAP="10"
OUTREACH_DISCOVERY_BATCH_SIZE="20"
# "false" sends every draft automatically once discovery finds a contact —
# leave this out (or "true") while trusting the review queue is still worth it.
OUTREACH_REQUIRE_APPROVAL="true"
