# Postgres connection string (Vercel Postgres / Neon / Supabase all work)
DATABASE_URL="postgresql://user:password@host:5432/fenderbcs?sslmode=require"

# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# Optional: password given to every seeded account on first setup
SEED_PASSWORD="ChangeMe123!"

# Optional — powers "Report a bug". Without it, reports still save to the
# database (Set Up -> Bug reports) but no email goes out.
# Sign up free at https://resend.com, verify a sending domain (or use their
# no-setup test address onboarding@resend.dev while trying this out).
RESEND_API_KEY=""
BUG_REPORT_TO_EMAIL="tyler@fendersteel.co.uk"
BUG_REPORT_FROM_EMAIL="Fender BCS <onboarding@resend.dev>"
