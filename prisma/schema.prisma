// Fender Steel — Business Control System
// Data model. Every table that touches steel carries traceability fields,
// because the CARES fabricator scheme requires full traceability for each
// cast of steel and each supplier.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------- companies
// Two businesses share this system: Fender Steel and its sister company BS
// Supplies (run out of the Scunthorpe branch). Orders, Customers, Products,
// Suppliers, compliance records and Production are private per company —
// only Planning (both companies run the same lorries) and physical/shared
// infrastructure (Assets, Drivers, Locations, Checks, the login system
// itself) are common to both. A user only sees a company's data if it's in
// their own `companies` list — see src/lib/company.ts.
enum Company {
  FENDER
  BS_SUPPLIES
}

// ---------------------------------------------------------------- people

enum Role {
  MASTER_ADMIN // Owns the whole system — every permission, both companies always.
  ADMIN // Same admin permissions as Master, but locked to a single company.
  MANAGER // Runs the yard day to day. No cost prices.
  SALES // Orders, customers, pricing view
  QUALITY // Compliance, NCRs, certificates, calibration
  YARD // Goods in, picking, production, delivery progress
  DRIVER // Their own runs and delivery sheets only
  VIEWER // Read only
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  jobTitle     String   @default("")
  role         Role     @default(VIEWER)
  passwordHash String
  active       Boolean  @default(true)
  initials     String   @default("")
  colour       String   @default("#16A085")
  mustReset    Boolean  @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  resetTokenHash    String?   // sha256 of the token emailed for "forgot password" — never the plain token
  resetTokenExpires DateTime?
  companies    Company[] @default([FENDER]) // which companies this account may view

  ordersRaised     Order[]          @relation("raisedBy")
  accountsManaged  Customer[]       @relation("accountManager")
  movements        StockMovement[]
  ncrsRaised       Ncr[]
  checklistDone    ChecklistItem[]
  inspections      Inspection[]
  activity         ActivityLog[]
  assetNotes       AssetNote[]
  qcChecks         QcCheck[]
  productionEvents ProductionEvent[]
  purchaseOrdersRaised PurchaseOrder[] @relation("poRaisedBy")
  assetChecks      AssetCheck[]
  notes            Note[]
  bugReports       BugReport[]
}

// ------------------------------------------------------------- customers

model Customer {
  id               String   @id @default(cuid())
  company          Company  @default(FENDER)
  code             String   @unique // CUST-0001
  name             String
  contactName      String   @default("")
  phone            String   @default("")
  email            String   @default("")
  address          String   @default("")
  town             String   @default("")
  postcode         String   @default("")
  paymentTerms     String   @default("30 days end of month")
  creditLimit      Decimal  @default(0) @db.Decimal(12, 2)
  status           String   @default("Active") // Active | On hold | Closed
  accountManagerId String?
  customerSince    DateTime @default(now())
  notes            String   @default("")

  accountManager User?   @relation("accountManager", fields: [accountManagerId], references: [id])
  orders         Order[]
  ncrs           Ncr[]
  documents      CustomerDocument[]

  @@index([company])
}

model CustomerDocument {
  id         String   @id @default(cuid())
  customerId String
  title      String
  kind       String   @default("Other") // PO | Spec | Insurance | Other
  url        String
  uploadedAt DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------- products/price

model Product {
  id          String  @id @default(cuid())
  company     Company @default(FENDER)
  code        String  @unique // RB12-500B
  name        String
  category    String // Reinforcing bar | Mesh fabric | Cut & bent | Dowels | ...
  unit        String  @default("t") // t | each | sheets | m
  kgPerUnit   Decimal @default(1000) @db.Decimal(12, 3)
  standard    String  @default("") // BS 4449:2005 B500B etc.
  reorderAt   Decimal @default(0) @db.Decimal(12, 3)
  active      Boolean @default(true)
  isRebar     Boolean @default(false) // drives traceability + FIFO batch picking

  prices     Price[]
  batches    Batch[]
  orderLines OrderLine[]
  movements  StockMovement[]
  purchaseOrderLines PurchaseOrderLine[]

  @@index([company])
}

// Selling prices only. Purchase cost is deliberately absent from this table —
// see docs/CARES-COMPLIANCE.md and the note on the Set Up screen.
model Price {
  id            String   @id @default(cuid())
  productId     String
  minQty        Decimal  @default(0) @db.Decimal(12, 3) // 0 = the base price
  unitPrice     Decimal  @db.Decimal(12, 2)
  effectiveFrom DateTime @default(now())
  setByName     String   @default("")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, minQty])
}

// Purchase costs live here and are readable by ADMIN only.
model PurchaseCost {
  id         String   @id @default(cuid())
  productId  String
  supplierId String?
  unitCost   Decimal  @db.Decimal(12, 2)
  recordedAt DateTime @default(now())
}

// ------------------------------------------------- suppliers and batches

model Supplier {
  id          String   @id @default(cuid())
  company     Company  @default(FENDER)
  name        String   @unique
  country     String   @default("United Kingdom")
  contactName String   @default("")
  email       String   @default("")
  phone       String   @default("")
  notes       String   @default("")
  approvedFor String   @default("") // e.g. "BS 4449:2005 B500B bar"
  blocked     Boolean  @default(false)
  createdAt   DateTime @default(now())

  batches      Batch[]
  certificates Certificate[]
  ncrs         Ncr[]
  purchaseOrders PurchaseOrder[]

  @@index([company])
}

// A batch is one cast/heat of steel received against one mill certificate.
model Batch {
  id            String   @id @default(cuid())
  company       Company  @default(FENDER)
  heatNumber    String // cast / heat number stamped by the mill
  productId     String
  supplierId    String
  certNumber    String   @default("")
  millCertUrl   String   @default("")
  receivedAt    DateTime @default(now())
  qtyReceived   Decimal  @db.Decimal(12, 3)
  qtyRemaining  Decimal  @db.Decimal(12, 3)
  unitCost      Decimal? @db.Decimal(12, 2) // what we paid — finance.costs only
  depot         String   @default("Scunthorpe") // which branch this delivery is at
  location      String   @default("") // where within that branch, e.g. "Yard B2"
  deliveryNote  String   @default("")
  status        String   @default("Available") // Available | Quarantined | Consumed | Rejected
  quarantineRef String   @default("")

  product   Product         @relation(fields: [productId], references: [id])
  supplier  Supplier        @relation(fields: [supplierId], references: [id])
  movements StockMovement[]
  orderLines OrderLine[]
  ncrs      Ncr[]

  @@unique([heatNumber, productId])
  @@index([productId, receivedAt])
}

enum MovementType {
  GOODS_IN
  PICKED
  RETURNED
  ADJUSTMENT
  SCRAP
  QUARANTINE
  RELEASED
}

model StockMovement {
  id        String       @id @default(cuid())
  productId String
  batchId   String?
  type      MovementType
  qty       Decimal      @db.Decimal(12, 3)
  reference String       @default("") // order number, delivery note, NCR ref
  reason    String       @default("")
  userId    String?
  at        DateTime     @default(now())

  product Product @relation(fields: [productId], references: [id])
  batch   Batch?  @relation(fields: [batchId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@index([productId, at])
}

// ------------------------------------------------------------- ordering

enum OrderStage {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  IN_PRODUCTION
  READY_FOR_DELIVERY
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  CREDIT_NOTE
}

model Order {
  id            String        @id @default(cuid())
  company       Company       @default(FENDER)
  number        String        @unique // FS-26-05301
  customerId    String
  stage         OrderStage    @default(DRAFT)
  paymentStatus PaymentStatus @default(UNPAID)
  deliveryDate  DateTime?
  town          String        @default("")
  address       String        @default("")
  poNumber      String        @default("")
  yardNotes     String        @default("")
  raisedById    String?
  archived      Boolean       @default(false)
  overrideCredit Boolean      @default(false)
  approvedAt    DateTime?
  approvedBy    String        @default("")
  deliveredAt   DateTime?
  paidAt        DateTime?
  completedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer  Customer        @relation(fields: [customerId], references: [id])
  raisedBy  User?           @relation("raisedBy", fields: [raisedById], references: [id])
  lines     OrderLine[]
  barMarks  BarMark[]
  checklist ChecklistItem[]
  events    PlanningEvent[]
  ncrs      Ncr[]
  production ProductionEvent[]

  @@index([stage, deliveryDate])
  @@index([company])
}

model OrderLine {
  id          String  @id @default(cuid())
  orderId     String
  productId   String?
  description String
  qty         Decimal @db.Decimal(12, 3)
  unit        String  @default("t")
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)
  weightKg    Decimal @default(0) @db.Decimal(12, 3)
  batchId     String? // set when stock is picked, gives the cert on the note
  sortOrder   Int     @default(0)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
  batch   Batch?   @relation(fields: [batchId], references: [id])
}

// --------------------------------------------------------- purchase orders
// Orders placed WITH a supplier to buy steel/materials — distinct from the
// Order model above, which is a sales order raised FOR a customer. Status is
// tracked here; actually booking the steel into stock (heat number, mill
// cert) still goes through Stock -> Goods In as it always has.

enum PurchaseOrderStatus {
  DRAFT
  SENT
  CONFIRMED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  company      Company             @default(FENDER)
  number       String              @unique // PO-26-0001
  supplierId   String
  status       PurchaseOrderStatus @default(DRAFT)
  expectedDate DateTime?
  notes        String              @default("")
  raisedById   String?
  costCentreId String?
  sentAt       DateTime?
  confirmedAt  DateTime?
  receivedAt   DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  supplier   Supplier    @relation(fields: [supplierId], references: [id])
  raisedBy   User?       @relation("poRaisedBy", fields: [raisedById], references: [id])
  costCentre CostCentre? @relation(fields: [costCentreId], references: [id])
  lines      PurchaseOrderLine[]

  @@index([status, expectedDate])
  @@index([company])
}

// Purchase cost fields here follow the same guardrail as PurchaseCost above —
// only someone with finance.costs sees unitCost/lineTotal in the UI.
model PurchaseOrderLine {
  id              String  @id @default(cuid())
  purchaseOrderId String
  productId       String?
  description     String
  qty             Decimal @db.Decimal(12, 3)
  unit            String  @default("t")
  unitCost        Decimal @default(0) @db.Decimal(12, 2)
  lineTotal       Decimal @default(0) @db.Decimal(12, 2)
  sortOrder       Int     @default(0)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product?      @relation(fields: [productId], references: [id])
}

// One line per bar mark on the customer's bending schedule (BS 8666:2020).
model BarMark {
  id        String  @id @default(cuid())
  orderId   String
  mark      String // B01
  diaMm     Int
  shapeCode String // "21", "51", "99"...
  shapeName String  @default("")
  lengthMm  Int // total cutting length
  bars      Int
  a         Int?
  b         Int?
  c         Int?
  d         Int?
  ef        Int?
  radiusMm  Int?
  weightKg  Decimal @default(0) @db.Decimal(12, 3)
  unitPrice Decimal @default(0) @db.Decimal(12, 2)
  lineTotal Decimal @default(0) @db.Decimal(12, 2)
  batchId   String?
  status    String  @default("Scheduled") // Scheduled | Cut | Bent | Checked | Tagged
  sortOrder Int     @default(0)

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  qcChecks QcCheck[]
}

model ChecklistItem {
  id        String    @id @default(cuid())
  orderId   String
  label     String
  done      Boolean   @default(false)
  doneById  String?
  doneAt    DateTime?
  sortOrder Int       @default(0)

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  doneBy User? @relation(fields: [doneById], references: [id])
}

// The default checklist applied to every new order — editable in Set Up.
// Each company keeps its own list.
model ChecklistTemplate {
  id        String  @id @default(cuid())
  company   Company @default(FENDER)
  label     String
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  @@index([company])
}

// ------------------------------------------------------------ production

model ProductionEvent {
  id        String   @id @default(cuid())
  orderId   String
  station   String // Shear line | Bar bender | Link bender | Mesh | Loading
  assetId   String?
  action    String // Started | Paused | Completed | Checked
  note      String   @default("")
  userId    String?
  at        DateTime @default(now())

  order Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User?  @relation(fields: [userId], references: [id])
  asset Asset? @relation(fields: [assetId], references: [id])
}

// Dimensional check against BS 8666 tolerances. Evidence for the auditor.
model QcCheck {
  id          String   @id @default(cuid())
  barMarkId   String
  dimension   String // "Total length" | "A" | "B" ...
  nominalMm   Int
  measuredMm  Int
  toleranceMm String   @default("")
  pass        Boolean
  checkedById String?
  at          DateTime @default(now())
  note        String   @default("")

  barMark   BarMark @relation(fields: [barMarkId], references: [id], onDelete: Cascade)
  checkedBy User?   @relation(fields: [checkedById], references: [id])
}

// --------------------------------------------------------- compliance

model Certificate {
  id         String   @id @default(cuid())
  company    Company  @default(FENDER)
  scheme     String // CARES SRC | Supplier | ISO 9001 | ISO 14001 | ISO 45001 | Calibration
  title      String
  reference  String   @default("")
  holder     String   @default("Fender Steel") // company, or supplier name
  supplierId String?
  issuedOn   DateTime
  expiresOn  DateTime
  fileUrl    String   @default("")
  notes      String   @default("")

  supplier Supplier? @relation(fields: [supplierId], references: [id])

  @@index([expiresOn])
  @@index([company])
}

enum NcrType {
  CUSTOMER_COMPLAINT
  INTERNAL
  SUPPLIER_ISSUE
}

enum NcrStatus {
  OPEN
  CLOSED
}

model Ncr {
  id               String    @id @default(cuid())
  company          Company   @default(FENDER)
  ref              String    @unique // NCR-26-013
  type             NcrType
  status           NcrStatus @default(OPEN)
  description      String
  correctiveAction String    @default("")
  rootCause        String    @default("")
  orderId          String?
  customerId       String?
  batchId          String?
  supplierId       String?
  raisedById       String?
  raisedAt         DateTime  @default(now())
  closedAt         DateTime?
  closedBy         String    @default("")

  order    Order?    @relation(fields: [orderId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  batch    Batch?    @relation(fields: [batchId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])
  raisedBy User?     @relation(fields: [raisedById], references: [id])

  @@index([company])
}

model AuditAction {
  id          String    @id @default(cuid())
  company     Company   @default(FENDER)
  ref         String    @unique
  source      String    @default("CARES audit") // CARES audit | Internal audit | Management review
  description String
  owner       String    @default("")
  dueOn       DateTime?
  closedAt    DateTime?
  evidence    String    @default("")

  @@index([company])
}

// Quarterly tonnage return to CARES. Each company files its own.
model QuarterlyReturn {
  id          String    @id @default(cuid())
  company     Company   @default(FENDER)
  period      String    // 2026-Q2
  tonnage     Decimal   @db.Decimal(12, 3)
  preparedBy  String    @default("")
  submittedAt DateTime?
  reference   String    @default("")
  notes       String    @default("")

  @@unique([period, company])
}

// -------------------------------------------------------------- assets

enum AssetType {
  VEHICLE
  MACHINE
}

model Asset {
  id             String    @id @default(cuid())
  ref            String    @unique // VH-001 / MC-001
  type           AssetType
  name           String // registration or machine name
  category       String // HGV | Van | Pickup | Bar bender | Shear line ...
  makeModel      String    @default("")
  year           Int?
  serialNumber   String    @default("")
  depot          String    @default("Scunthorpe")
  hours          Int?
  liftingEquipment Boolean @default(false)
  retired        Boolean   @default(false)

  motDue         DateTime?
  taxDue         DateTime?
  weeklyCheckDue DateTime? // 13-week / periodic safety inspection
  puwerDue       DateTime?
  lolerDue       DateTime?
  serviceDue     DateTime?
  calibrationDue DateTime? // control of measuring devices — CARES requirement

  inspections Inspection[]
  notes       AssetNote[]
  events      PlanningEvent[]
  production  ProductionEvent[]
  checks      AssetCheck[]
}

model Inspection {
  id           String   @id @default(cuid())
  assetId      String
  kind         String // MOT | PUWER | LOLER | Service | Calibration | Safety check
  result       String   @default("Pass") // Pass | Fail | Advisory
  provider     String   @default("")
  performedOn  DateTime
  nextDueOn    DateTime?
  certificate  String   @default("")
  notes        String   @default("")
  loggedById   String?

  asset    Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  loggedBy User? @relation(fields: [loggedById], references: [id])
}

// A morning pre-use check — machines, lorries and pickups, ticked through
// before the yard starts, with who did it and when kept for the record.
enum CheckResult {
  PASS
  FAIL
}

model AssetCheck {
  id          String      @id @default(cuid())
  assetId     String
  userId      String?
  performedAt DateTime    @default(now())
  result      CheckResult @default(PASS)
  notes       String      @default("")

  asset Asset            @relation(fields: [assetId], references: [id])
  user  User?            @relation(fields: [userId], references: [id])
  items AssetCheckItem[]

  @@index([assetId, performedAt])
}

model AssetCheckItem {
  id      String  @id @default(cuid())
  checkId String
  label   String
  ok      Boolean @default(true)
  note    String  @default("")

  check AssetCheck @relation(fields: [checkId], references: [id], onDelete: Cascade)
}

model AssetNote {
  id      String   @id @default(cuid())
  assetId String
  body    String
  userId  String?
  at      DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id])
}

// ------------------------------------------------------------- planning

enum EventType {
  DELIVERY
  COLLECTION
  INSPECTION
  SERVICE
  AUDIT
  OTHER
}

model PlanningEvent {
  id         String    @id @default(cuid())
  title      String
  type       EventType @default(OTHER)
  startsAt   DateTime
  allDay     Boolean   @default(false)
  town       String    @default("")
  detail     String    @default("")
  orderId    String?
  assetId    String?
  assignedTo String    @default("")
  done       Boolean   @default(false)

  order Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)
  asset Asset? @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([startsAt])
}

// ---------------------------------------------------------------- setup

model Town {
  id     String  @id @default(cuid())
  name   String  @unique
  region String  @default("")
  active Boolean @default(true)
}

// Our own depots/branches — shared by both companies. Drives the Asset/
// Driver/Batch `depot` fields (plain strings, not a hard foreign key, kept
// consistent by only ever offering this list in the relevant forms).
model Location {
  id     String  @id @default(cuid())
  name   String  @unique
  active Boolean @default(true)
}

// Which internal budget a purchase order's spend is tracked against — a
// BCS Products thing today, not used on the Fender side.
model CostCentre {
  id      String  @id @default(cuid())
  company Company @default(FENDER)
  name    String
  active  Boolean @default(true)

  purchaseOrders PurchaseOrder[]

  @@unique([company, name])
}

// Freeform notes — used today for the Checks area (anything worth logging
// that isn't tied to a specific machine/lorry check).
model Note {
  id     String   @id @default(cuid())
  body   String
  userId String?
  at     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model Driver {
  id       String  @id @default(cuid())
  name     String
  phone    String  @default("")
  licence  String  @default("")
  cpcExpiry DateTime?
  depot    String  @default("Scunthorpe")
  active   Boolean @default(true)
}

model Setting {
  key   String @id
  value String
}

// "Report a bug" — always saved here first so nothing is lost even if the
// outgoing email fails or RESEND_API_KEY isn't configured yet.
model BugReport {
  id          String   @id @default(cuid())
  description String
  page        String   @default("") // which screen they were on
  company     Company? // which company's view was active, if relevant
  userName    String   @default("")
  userEmail   String   @default("")
  emailSent   Boolean  @default(false)
  createdAt   DateTime @default(now())
  userId      String?

  user User? @relation(fields: [userId], references: [id])
}

model ActivityLog {
  id       String   @id @default(cuid())
  entity   String // Order | Batch | Customer | Asset | Ncr
  entityId String
  action   String
  detail   String   @default("")
  userId   String?
  at       DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
}
