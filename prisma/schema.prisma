// Fender Steel — Business Control System
// Data model. Every table that touches steel carries traceability fields,
// because the CARES fabricator scheme requires full traceability for each
// cast of steel and each supplier.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- people

enum Role {
  ADMIN // CEO / directors — everything, including cost and margin
  MANAGER // Runs the yard day to day. No cost prices.
  SALES // Orders, customers, pricing view
  QUALITY // Compliance, NCRs, certificates, calibration
  YARD // Goods in, picking, production, delivery progress
  DRIVER // Their own runs and delivery sheets only
  VIEWER // Read only
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  jobTitle     String   @default("")
  role         Role     @default(VIEWER)
  passwordHash String
  active       Boolean  @default(true)
  initials     String   @default("")
  colour       String   @default("#16A085")
  mustReset    Boolean  @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())

  ordersRaised     Order[]          @relation("raisedBy")
  accountsManaged  Customer[]       @relation("accountManager")
  movements        StockMovement[]
  ncrsRaised       Ncr[]
  checklistDone    ChecklistItem[]
  inspections      Inspection[]
  activity         ActivityLog[]
  assetNotes       AssetNote[]
  qcChecks         QcCheck[]
  productionEvents ProductionEvent[]
}

// ------------------------------------------------------------- customers

model Customer {
  id               String   @id @default(cuid())
  code             String   @unique // CUST-0001
  name             String
  contactName      String   @default("")
  phone            String   @default("")
  email            String   @default("")
  address          String   @default("")
  town             String   @default("")
  postcode         String   @default("")
  paymentTerms     String   @default("30 days end of month")
  creditLimit      Decimal  @default(0) @db.Decimal(12, 2)
  status           String   @default("Active") // Active | On hold | Closed
  accountManagerId String?
  customerSince    DateTime @default(now())
  notes            String   @default("")

  accountManager User?   @relation("accountManager", fields: [accountManagerId], references: [id])
  orders         Order[]
  ncrs           Ncr[]
  documents      CustomerDocument[]
}

model CustomerDocument {
  id         String   @id @default(cuid())
  customerId String
  title      String
  kind       String   @default("Other") // PO | Spec | Insurance | Other
  url        String
  uploadedAt DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------- products/price

model Product {
  id          String  @id @default(cuid())
  code        String  @unique // RB12-500B
  name        String
  category    String // Reinforcing bar | Mesh fabric | Cut & bent | Dowels | ...
  unit        String  @default("t") // t | each | sheets | m
  kgPerUnit   Decimal @default(1000) @db.Decimal(12, 3)
  standard    String  @default("") // BS 4449:2005 B500B etc.
  reorderAt   Decimal @default(0) @db.Decimal(12, 3)
  active      Boolean @default(true)
  isRebar     Boolean @default(false) // drives traceability + FIFO batch picking

  prices     Price[]
  batches    Batch[]
  orderLines OrderLine[]
  movements  StockMovement[]
}

// Selling prices only. Purchase cost is deliberately absent from this table —
// see docs/CARES-COMPLIANCE.md and the note on the Set Up screen.
model Price {
  id            String   @id @default(cuid())
  productId     String
  minQty        Decimal  @default(0) @db.Decimal(12, 3) // 0 = the base price
  unitPrice     Decimal  @db.Decimal(12, 2)
  effectiveFrom DateTime @default(now())
  setByName     String   @default("")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, minQty])
}

// Purchase costs live here and are readable by ADMIN only.
model PurchaseCost {
  id         String   @id @default(cuid())
  productId  String
  supplierId String?
  unitCost   Decimal  @db.Decimal(12, 2)
  recordedAt DateTime @default(now())
}

// ------------------------------------------------- suppliers and batches

model Supplier {
  id          String   @id @default(cuid())
  name        String   @unique
  country     String   @default("United Kingdom")
  contactName String   @default("")
  email       String   @default("")
  phone       String   @default("")
  notes       String   @default("")
  approvedFor String   @default("") // e.g. "BS 4449:2005 B500B bar"
  blocked     Boolean  @default(false)
  createdAt   DateTime @default(now())

  batches      Batch[]
  certificates Certificate[]
  ncrs         Ncr[]
}

// A batch is one cast/heat of steel received against one mill certificate.
model Batch {
  id            String   @id @default(cuid())
  heatNumber    String // cast / heat number stamped by the mill
  productId     String
  supplierId    String
  certNumber    String   @default("")
  millCertUrl   String   @default("")
  receivedAt    DateTime @default(now())
  qtyReceived   Decimal  @db.Decimal(12, 3)
  qtyRemaining  Decimal  @db.Decimal(12, 3)
  location      String   @default("")
  deliveryNote  String   @default("")
  status        String   @default("Available") // Available | Quarantined | Consumed | Rejected
  quarantineRef String   @default("")

  product   Product         @relation(fields: [productId], references: [id])
  supplier  Supplier        @relation(fields: [supplierId], references: [id])
  movements StockMovement[]
  orderLines OrderLine[]
  ncrs      Ncr[]

  @@unique([heatNumber, productId])
  @@index([productId, receivedAt])
}

enum MovementType {
  GOODS_IN
  PICKED
  RETURNED
  ADJUSTMENT
  SCRAP
  QUARANTINE
  RELEASED
}

model StockMovement {
  id        String       @id @default(cuid())
  productId String
  batchId   String?
  type      MovementType
  qty       Decimal      @db.Decimal(12, 3)
  reference String       @default("") // order number, delivery note, NCR ref
  reason    String       @default("")
  userId    String?
  at        DateTime     @default(now())

  product Product @relation(fields: [productId], references: [id])
  batch   Batch?  @relation(fields: [batchId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@index([productId, at])
}

// ------------------------------------------------------------- ordering

enum OrderStage {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  IN_PRODUCTION
  READY_FOR_DELIVERY
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  CREDIT_NOTE
}

model Order {
  id            String        @id @default(cuid())
  number        String        @unique // FS-26-05301
  customerId    String
  stage         OrderStage    @default(DRAFT)
  paymentStatus PaymentStatus @default(UNPAID)
  deliveryDate  DateTime?
  town          String        @default("")
  address       String        @default("")
  poNumber      String        @default("")
  yardNotes     String        @default("")
  raisedById    String?
  archived      Boolean       @default(false)
  overrideCredit Boolean      @default(false)
  approvedAt    DateTime?
  approvedBy    String        @default("")
  deliveredAt   DateTime?
  paidAt        DateTime?
  completedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer  Customer        @relation(fields: [customerId], references: [id])
  raisedBy  User?           @relation("raisedBy", fields: [raisedById], references: [id])
  lines     OrderLine[]
  barMarks  BarMark[]
  checklist ChecklistItem[]
  events    PlanningEvent[]
  ncrs      Ncr[]
  production ProductionEvent[]

  @@index([stage, deliveryDate])
}

model OrderLine {
  id          String  @id @default(cuid())
  orderId     String
  productId   String?
  description String
  qty         Decimal @db.Decimal(12, 3)
  unit        String  @default("t")
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)
  weightKg    Decimal @default(0) @db.Decimal(12, 3)
  batchId     String? // set when stock is picked, gives the cert on the note
  sortOrder   Int     @default(0)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
  batch   Batch?   @relation(fields: [batchId], references: [id])
}

// One line per bar mark on the customer's bending schedule (BS 8666:2020).
model BarMark {
  id        String  @id @default(cuid())
  orderId   String
  mark      String // B01
  diaMm     Int
  shapeCode String // "21", "51", "99"...
  shapeName String  @default("")
  lengthMm  Int // total cutting length
  bars      Int
  a         Int?
  b         Int?
  c         Int?
  d         Int?
  ef        Int?
  radiusMm  Int?
  weightKg  Decimal @default(0) @db.Decimal(12, 3)
  unitPrice Decimal @default(0) @db.Decimal(12, 2)
  lineTotal Decimal @default(0) @db.Decimal(12, 2)
  batchId   String?
  status    String  @default("Scheduled") // Scheduled | Cut | Bent | Checked | Tagged
  sortOrder Int     @default(0)

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  qcChecks QcCheck[]
}

model ChecklistItem {
  id        String    @id @default(cuid())
  orderId   String
  label     String
  done      Boolean   @default(false)
  doneById  String?
  doneAt    DateTime?
  sortOrder Int       @default(0)

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  doneBy User? @relation(fields: [doneById], references: [id])
}

// The default checklist applied to every new order — editable in Set Up.
model ChecklistTemplate {
  id        String  @id @default(cuid())
  label     String
  sortOrder Int     @default(0)
  active    Boolean @default(true)
}

// ------------------------------------------------------------ production

model ProductionEvent {
  id        String   @id @default(cuid())
  orderId   String
  station   String // Shear line | Bar bender | Link bender | Mesh | Loading
  assetId   String?
  action    String // Started | Paused | Completed | Checked
  note      String   @default("")
  userId    String?
  at        DateTime @default(now())

  order Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User?  @relation(fields: [userId], references: [id])
  asset Asset? @relation(fields: [assetId], references: [id])
}

// Dimensional check against BS 8666 tolerances. Evidence for the auditor.
model QcCheck {
  id          String   @id @default(cuid())
  barMarkId   String
  dimension   String // "Total length" | "A" | "B" ...
  nominalMm   Int
  measuredMm  Int
  toleranceMm String   @default("")
  pass        Boolean
  checkedById String?
  at          DateTime @default(now())
  note        String   @default("")

  barMark   BarMark @relation(fields: [barMarkId], references: [id], onDelete: Cascade)
  checkedBy User?   @relation(fields: [checkedById], references: [id])
}

// --------------------------------------------------------- compliance

model Certificate {
  id         String   @id @default(cuid())
  scheme     String // CARES SRC | Supplier | ISO 9001 | ISO 14001 | ISO 45001 | Calibration
  title      String
  reference  String   @default("")
  holder     String   @default("Fender Steel") // company, or supplier name
  supplierId String?
  issuedOn   DateTime
  expiresOn  DateTime
  fileUrl    String   @default("")
  notes      String   @default("")

  supplier Supplier? @relation(fields: [supplierId], references: [id])

  @@index([expiresOn])
}

enum NcrType {
  CUSTOMER_COMPLAINT
  INTERNAL
  SUPPLIER_ISSUE
}

enum NcrStatus {
  OPEN
  CLOSED
}

model Ncr {
  id               String    @id @default(cuid())
  ref              String    @unique // NCR-26-013
  type             NcrType
  status           NcrStatus @default(OPEN)
  description      String
  correctiveAction String    @default("")
  rootCause        String    @default("")
  orderId          String?
  customerId       String?
  batchId          String?
  supplierId       String?
  raisedById       String?
  raisedAt         DateTime  @default(now())
  closedAt         DateTime?
  closedBy         String    @default("")

  order    Order?    @relation(fields: [orderId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  batch    Batch?    @relation(fields: [batchId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])
  raisedBy User?     @relation(fields: [raisedById], references: [id])
}

model AuditAction {
  id          String    @id @default(cuid())
  ref         String    @unique
  source      String    @default("CARES audit") // CARES audit | Internal audit | Management review
  description String
  owner       String    @default("")
  dueOn       DateTime?
  closedAt    DateTime?
  evidence    String    @default("")
}

// Quarterly tonnage return to CARES.
model QuarterlyReturn {
  id          String    @id @default(cuid())
  period      String    @unique // 2026-Q2
  tonnage     Decimal   @db.Decimal(12, 3)
  preparedBy  String    @default("")
  submittedAt DateTime?
  reference   String    @default("")
  notes       String    @default("")
}

// -------------------------------------------------------------- assets

enum AssetType {
  VEHICLE
  MACHINE
}

model Asset {
  id             String    @id @default(cuid())
  ref            String    @unique // VH-001 / MC-001
  type           AssetType
  name           String // registration or machine name
  category       String // HGV | Van | Pickup | Bar bender | Shear line ...
  makeModel      String    @default("")
  year           Int?
  serialNumber   String    @default("")
  depot          String    @default("Scunthorpe")
  hours          Int?
  liftingEquipment Boolean @default(false)
  retired        Boolean   @default(false)

  motDue         DateTime?
  taxDue         DateTime?
  weeklyCheckDue DateTime? // 13-week / periodic safety inspection
  puwerDue       DateTime?
  lolerDue       DateTime?
  serviceDue     DateTime?
  calibrationDue DateTime? // control of measuring devices — CARES requirement

  inspections Inspection[]
  notes       AssetNote[]
  events      PlanningEvent[]
  production  ProductionEvent[]
}

model Inspection {
  id           String   @id @default(cuid())
  assetId      String
  kind         String // MOT | PUWER | LOLER | Service | Calibration | Safety check
  result       String   @default("Pass") // Pass | Fail | Advisory
  provider     String   @default("")
  performedOn  DateTime
  nextDueOn    DateTime?
  certificate  String   @default("")
  notes        String   @default("")
  loggedById   String?

  asset    Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  loggedBy User? @relation(fields: [loggedById], references: [id])
}

model AssetNote {
  id      String   @id @default(cuid())
  assetId String
  body    String
  userId  String?
  at      DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id])
}

// ------------------------------------------------------------- planning

enum EventType {
  DELIVERY
  COLLECTION
  INSPECTION
  SERVICE
  AUDIT
  OTHER
}

model PlanningEvent {
  id         String    @id @default(cuid())
  title      String
  type       EventType @default(OTHER)
  startsAt   DateTime
  allDay     Boolean   @default(false)
  town       String    @default("")
  detail     String    @default("")
  orderId    String?
  assetId    String?
  assignedTo String    @default("")
  done       Boolean   @default(false)

  order Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)
  asset Asset? @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([startsAt])
}

// ---------------------------------------------------------------- setup

model Town {
  id     String  @id @default(cuid())
  name   String  @unique
  region String  @default("")
  active Boolean @default(true)
}

model Driver {
  id       String  @id @default(cuid())
  name     String
  phone    String  @default("")
  licence  String  @default("")
  cpcExpiry DateTime?
  depot    String  @default("Scunthorpe")
  active   Boolean @default(true)
}

model Setting {
  key   String @id
  value String
}

model ActivityLog {
  id       String   @id @default(cuid())
  entity   String // Order | Batch | Customer | Asset | Ncr
  entityId String
  action   String
  detail   String   @default("")
  userId   String?
  at       DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
}
